{
  "id": "relu_bwd",
  "name": "relu_bwd",
  "kind": "elementwise_bwd",
  "tags": [
    "cuda",
    "relu",
    "backward",
    "elementwise",
    "any-rank",
    "flatten",
    "contiguous",
    "f32",
    "f16",
    "half2",
    "vec2",
    "memory-bound",
    "no-attr",
    "no-workspace"
  ],
  "summary": "ReLU backward: dY = dOut if Y>0 else 0. Inputs: (dOut, Y) output: (dY). Any-rank contiguous tensors flattened to numel. Variants: f32 naive, f16 naive, f16 half2(vec2) fastpath when numel even and pointers 4B aligned. No attrs, no workspace.",
  "contract": [
    "Inputs: 2 tensors: dOut, Y. Outputs: 1 tensor: dY.",
    "Semantics: dY[i] = (Y[i] > 0) ? dOut[i] : 0.",
    "DType:",
    " - f32 path: dOut=f32, Y=f32, dY=f32",
    " - f16 path: dOut=f16, Y=f16, dY=f16",
    "Shape:",
    " - Y, dOut, dY must have same rank and identical shape (rank>=1).",
    "Layout:",
    " - Y, dOut, dY must be contiguous (TensorDesc.contiguous==true).",
    "Attrs:",
    " - none (attr ignored / not present).",
    "Workspace:",
    " - none (0 bytes)."
  ],
  "abi": [
    "AttrBlob: not used. expected_attr_schema_id=0.",
    "Workspace: query_workspace returns 0."
  ],
  "notes": [
    "Kernels operate on int64 numel for indexing; launch uses blocks capped to 65535.",
    "f16 vec2 path processes __half2 lanes; requires numel even and 4B alignment for all three pointers."
  ],
  "variants": [
    {
      "id": "v_relu_bwd_f32",
      "name": "relu_bwd_f32",
      "priority": 0,
      "flags": 0,
      "expected_attr_schema_id": 0,
      "supported": [
        "num_inputs==2, num_outputs==1",
        "Y.dtype==f32 && dOut.dtype==f32 && dY.dtype==f32",
        "Y,dOut,dY are contiguous",
        "same shape (any-rank, rank>=1)",
        "numel>0 (computed from Y.shape)"
      ],
      "kernel": "relu_bwd_f32_kernel",
      "launch": "threads=256, blocks=min(65535, ceil_div(numel,256))"
    },
    {
      "id": "v_relu_bwd_f16",
      "name": "relu_bwd_f16_naive",
      "priority": 0,
      "flags": 0,
      "expected_attr_schema_id": 0,
      "supported": [
        "num_inputs==2, num_outputs==1",
        "Y.dtype==f16 && dOut.dtype==f16 && dY.dtype==f16",
        "Y,dOut,dY are contiguous",
        "same shape (any-rank, rank>=1)",
        "numel>0"
      ],
      "kernel": "relu_bwd_f16_kernel",
      "launch": "threads=256, blocks=min(65535, ceil_div(numel,256))"
    },
    {
      "id": "v_relu_bwd_f16_vec2",
      "name": "relu_bwd_f16_vec2_half2",
      "priority": 10,
      "flags": 0,
      "expected_attr_schema_id": 0,
      "supported": [
        "All relu_bwd_f16_naive conditions",
        "numel even",
        "Y.data 4B aligned",
        "dOut.data 4B aligned",
        "dY.data 4B aligned"
      ],
      "kernel": "relu_bwd_f16x2_kernel",
      "launch": "threads=256, blocks=min(65535, ceil_div(numel/2,256))",
      "notes": "Computes lane-wise (y>0)?g:0 for both halves."
    }
  ],
  "suites": [
    {
      "id": "suite_correctness",
      "name": "correctness",
      "desc": "Validate backward mask semantics vs reference implementation.",
      "cases": [
        { "id": "case_f32_small", "dtype": "f32", "shape": "[1024]" },
        { "id": "case_f32_2d", "dtype": "f32", "shape": "[128,256]" },
        { "id": "case_f16_small", "dtype": "f16", "shape": "[2048]" },
        { "id": "case_f16_odd", "dtype": "f16", "shape": "[2049]", "expect_variant": "naive" }
      ]
    },
    {
      "id": "suite_vec2_gating",
      "name": "half2_gating",
      "desc": "Ensure vec2 selection only when safe.",
      "cases": [
        { "id": "case_even_aligned", "dtype": "f16", "shape": "[4096]", "expect_variant": "vec2" },
        {
          "id": "case_misaligned_any",
          "dtype": "f16",
          "shape": "[4096]",
          "expect_variant": "naive",
          "notes": "Force one of (Y,dOut,dY) pointers to be misaligned to 4B."
        }
      ]
    }
  ],
  "experiments": [
    {
      "id": "exp_vec2_half2",
      "ts": 0,
      "title": "half2 fastpath for relu_bwd",
      "change": "Add __half2 kernel processing two elements per thread when aligned and even numel.",
      "why": "Reduce instruction overhead and improve memory throughput on bandwidth-bound backward pass.",
      "hypothesis": "vec2 path approaches memcpy-like throughput vs scalar half path.",
      "next": "Replace per-half comparisons with vector predicate/mask if you later switch to using input X instead of Y."
    }
  ],
  "measurements": [
    {
      "id": "m_template",
      "ts": 0,
      "variant_id": "v_relu_bwd_f16_vec2",
      "shape": "[4096,4096]",
      "lat_us": "",
      "gb_s": "",
      "notes": "Effective bytes ~= read(Y)+read(dOut)+write(dY) = numel*(2+2+2)B."
    }
  ]
}
